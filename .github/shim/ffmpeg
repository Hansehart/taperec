#!/usr/bin/env bash
# Runs Homebrew's ffmpeg with the recorder settings of $FFMPEG_VARIANT: current, ultrafast, notune or nice.
real=$(type -ap ffmpeg | grep -vx "$0" | head -n 1)
args=()
skip=0
for a in "$@"; do
  if [ "$skip" = 1 ]; then skip=0; continue; fi
  case ${FFMPEG_VARIANT:-current}:$a in
    ultrafast:veryfast) a=ultrafast ;;
    notune:-tune) skip=1; continue ;;
  esac
  args+=("$a")
done
if [ "${FFMPEG_VARIANT:-current}" = nice ]; then exec nice -n 10 "$real" "${args[@]}"; fi
exec "$real" "${args[@]}"
