{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "taperec edit",
  "description": "An edit file: items on tracks, each placed against the recording's marks.",
  "type": "object",
  "properties": {
    "bar": {
      "description": "Where the bar sits and how long a chapter's card holds; `{ at: top, offset: 0, card: 2s }` unless given.",
      "$ref": "#/$defs/BarSettings"
    },
    "tracks": {
      "description": "The tracks; within one, a later item lies on top of an earlier one.",
      "$ref": "#/$defs/Tracks"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "BarSettings": {
      "description": "Where the bar sits, and how long each new chapter's card holds the video.",
      "type": "object",
      "properties": {
        "at": {
          "description": "The screen's edge the bar sits along.",
          "$ref": "#/$defs/Edge"
        },
        "card": {
          "description": "How long a new chapter's card holds the video before it moves into the bar; `0s` shows no cards.",
          "$ref": "#/$defs/Duration"
        },
        "offset": {
          "description": "Its distance from that edge, in pixels, e.g. to clear the Dock at the bottom.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "Duration": {
      "description": "A duration: whole milliseconds like `500ms`, or seconds or minutes like `1.5s` or `2m`.",
      "type": "string",
      "examples": [
        "500ms",
        "1.5s",
        "2m"
      ],
      "pattern": "^([0-9]+ms|[0-9]+(\\.[0-9]+)?[sm])$"
    },
    "Edge": {
      "description": "An edge of the screen.",
      "oneOf": [
        {
          "description": "The top, over the macOS menu bar.",
          "type": "string",
          "const": "top"
        },
        {
          "description": "The bottom.",
          "type": "string",
          "const": "bottom"
        }
      ]
    },
    "HoldItem": {
      "description": "The video held still at a moment for a while.",
      "type": "object",
      "properties": {
        "at": {
          "description": "The moment held.",
          "$ref": "#/$defs/Moment"
        },
        "duration": {
          "description": "How long it holds.",
          "$ref": "#/$defs/Duration"
        }
      },
      "additionalProperties": false,
      "required": [
        "at",
        "duration"
      ]
    },
    "MarkRef": {
      "type": "string",
      "examples": [
        "results"
      ],
      "pattern": "^[a-z0-9-]+$"
    },
    "Moment": {
      "description": "A mark of the tape, `start` or `end`, optionally moved by a duration.",
      "type": "string",
      "examples": [
        "start",
        "cage-built",
        "reopen + 3s",
        "results - 0.5s"
      ],
      "pattern": "^[a-z0-9-]+( [+-] ([0-9]+ms|[0-9]+(\\.[0-9]+)?[sm]))?$"
    },
    "Name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "Point": {
      "description": "A screen position in pixels from the top-left corner.",
      "type": "object",
      "properties": {
        "x": {
          "description": "Pixels from the left edge.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "y": {
          "description": "Pixels from the top edge.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ]
    },
    "SpeedItem": {
      "description": "A stretch fast-forwarded into `length` under a caption.",
      "type": "object",
      "properties": {
        "duration": {
          "description": "How long it really takes.",
          "$ref": "#/$defs/Duration"
        },
        "from": {
          "description": "Where the stretch starts.",
          "$ref": "#/$defs/Moment"
        },
        "label": {
          "description": "The caption shown while it plays, e.g. `Installing`.",
          "$ref": "#/$defs/Name"
        },
        "length": {
          "description": "How long it lasts in the video.",
          "$ref": "#/$defs/Duration"
        },
        "until": {
          "description": "Where it ends.",
          "anyOf": [
            {
              "$ref": "#/$defs/Moment"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "until"
          ]
        },
        {
          "required": [
            "duration"
          ]
        }
      ],
      "required": [
        "label",
        "length",
        "from"
      ]
    },
    "Text": {
      "type": "string"
    },
    "TextItem": {
      "description": "A chapter or comment shown from `from` until `until`, or for `duration`.",
      "type": "object",
      "properties": {
        "duration": {
          "description": "How long it lasts.",
          "$ref": "#/$defs/Duration"
        },
        "from": {
          "description": "When it starts.",
          "$ref": "#/$defs/Moment"
        },
        "text": {
          "description": "What it says; `\"\"` hides the texts beneath.",
          "$ref": "#/$defs/Text"
        },
        "until": {
          "description": "When it ends.",
          "anyOf": [
            {
              "$ref": "#/$defs/Moment"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "until"
          ]
        },
        {
          "required": [
            "duration"
          ]
        }
      ],
      "required": [
        "text",
        "from"
      ]
    },
    "Tracks": {
      "description": "The tracks of an edit.",
      "type": "object",
      "properties": {
        "chapter": {
          "description": "Where we are: each new chapter shows on a card, then in the bar; `\"\"` hides what lies beneath.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TextItem"
          }
        },
        "comment": {
          "description": "What to notice now, in the bar's middle; `\"\"` hides what lies beneath.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TextItem"
          }
        },
        "hold": {
          "description": "Frames held still for reading time; never within a speed-up.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/HoldItem"
          }
        },
        "speed": {
          "description": "Stretches fast-forwarded, named in the bar while they play; they must not overlap.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SpeedItem"
          }
        },
        "zoom": {
          "description": "Zooms onto a point, a mark's position or the window under a mark.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ZoomItem"
          }
        }
      },
      "additionalProperties": false
    },
    "ZoomItem": {
      "description": "A zoom onto a point, a mark's position or the window under a mark, eased in at `from` and out at the end.",
      "type": "object",
      "properties": {
        "at": {
          "description": "A mark recorded with a position, e.g. `mark: { name: results, at: { button: Run } }`.",
          "$ref": "#/$defs/MarkRef"
        },
        "duration": {
          "description": "How long it lasts.",
          "$ref": "#/$defs/Duration"
        },
        "from": {
          "description": "When the zoom starts.",
          "$ref": "#/$defs/Moment"
        },
        "point": {
          "description": "A screen position in pixels from the top-left corner.",
          "$ref": "#/$defs/Point"
        },
        "scale": {
          "description": "How far to zoom in, from 1 to 3; 1.5 unless given; the window sets it for `window`.",
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "maximum": 3.0,
          "minimum": 1.0
        },
        "until": {
          "description": "When it ends.",
          "anyOf": [
            {
              "$ref": "#/$defs/Moment"
            },
            {
              "type": "null"
            }
          ]
        },
        "window": {
          "description": "A mark recorded with a position, whose window the zoom frames with a margin, as far in as fits.",
          "$ref": "#/$defs/MarkRef"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "at"
              ]
            },
            {
              "required": [
                "point"
              ]
            },
            {
              "required": [
                "window"
              ]
            }
          ]
        },
        {
          "oneOf": [
            {
              "required": [
                "until"
              ]
            },
            {
              "required": [
                "duration"
              ]
            }
          ]
        }
      ],
      "required": [
        "from"
      ]
    }
  }
}
